<!DOCTYPE html>
<html lang="en">

  <%- include('include/head') %>

<body>
    <div data-barba="wrapper">
   
        <!-- start header -->
        <%- include('include/header') %>
            <!-- end header -->
            <!-- PAGE MAIN -->
            <div class="js-smooth-scroll bg-white" id="page-wrapper" data-barba="container">
                <main class="page-wrapper__content"
                    style="background-image: url('https://res.cloudinary.com/djcc1bova/image/upload/v1751628137/1_tkvye0.png');">
                    <!-- section MASTHEAD FULLSCREEN -->
                    <% if (contact) { %>
                        <section class="section section-masthead section-fullheight text-left bg-dark-1"
                            data-arts-os-animation="data-arts-os-animation" data-arts-theme-text="light"
                            data-background-color="var(--color-dark-1)">
                            <div class="section-masthead__inner section-fullheight__inner container-fluid">
                                <header class="row section-masthead__header justify-content-left">
                                    <div class="col-lg-6">
                                        <section
                                            class="section section-content clearfix pt-medium pb-medium container-fluid container-fluid_paddings"
                                            data-arts-os-animation="data-arts-os-animation">
                                            <div class="section-content__inner">
                                                <div class="w-100"></div>
                                                <div class="section__headline mb-1 mb-md-2"></div>
                                                <div class="w-100"></div>

                                                <div class="w-100"></div>
                                                <div class="section-content__text " data-split-text-type="lines"
                                                    data-split-text-set="lines">
                                                    <div class="section-content__heading  mb-1"
                                                        data-split-text-type="lines,words" data-split-text-set="words">
                                                        <h2 style="color: #ffffff;">
                                                            <%= contact.video_tag %>
                                                        </h2>
                                                    </div>

                                                    <p style="color: #ffffff;">
                                                        <%= contact.hero_des%>
                                                    </p>
                                                    <!-- <p>Here at OMAH, we like to test the limits of how much food can move
                                                    us. We go beyond food. We create experiences that stay with you.</p> -->
                                                </div>
                                            </div>
                                        </section>
                                    </div>
                                </header>
                            </div>



                            <div
                                class="section-image section-masthead__background section-masthead__background_fullscreen">
                                <div class="section-image__wrapper js-transition-img"
                                    data-arts-parallax="data-arts-parallax" data-arts-parallax-factor="0.15">
                                    <% if (contact.video && contact.video.length> 0) { %>
                                        <video class="js-transition-img__transformed-el" autoplay loop muted playsinline
                                            preload="auto"
                                            style="width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;z-index:1;">
                                            <source src="/<%= contact.video[0] %>" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                        <% } %>
                                </div>
                                <div class="overlay overlay_dark-30 section-masthead__overlay"></div>
                            </div>
                        </section>
                        <% } %>


                            <!-- section MASTHEAD -->
                            <section class="section section-masthead pt-small pb-small text-center"
                                data-arts-os-animation="data-arts-os-animation"
                                style="background-image: url('https://res.cloudinary.com/djcc1bova/image/upload/v1751628137/1_tkvye0.png');">
                                <div class="section-masthead__inner container-fluid">
                                    <header class="row section-masthead__header justify-content-center">
                                        <div class="col-lg-8">


                                            <div class="w-100"></div>
                                            <% if (contact) { %>
                                                <div class="section-masthead__heading split-text js-split-text"
                                                    data-split-text-type="lines,words" data-split-text-set="words">
                                                    <h1 class="mt-0 mb-0 h2" style="color: white">
                                                        <%= contact.form_title%>
                                                    </h1>
                                                </div>
                                                <% } %>
                                                    <div class="w-100"></div>
                                                    <div class="section__headline mt-2 mx-auto"></div>
                                        </div>
                                    </header>
                                </div>
                            </section>
                            <!-- - section MASTHEAD -->

                            <!-- - section CONTENT #1 -->
                            <div class="container container_px-xs-0">
                                <div class="row justify-content-center">
                                    <div class="col-lg-8 p-2">
                                        <!-- section FORM -->
                                        <section class="section section-form pb-small">
                                            <form class="form form-contact js-ajax-form bg-white form-contact_paddingss p-4"
                                                action="/api/createenquiries" method="POST"
                                                data-message-success="Thanks for your message! We will reply you as soon as possible."
                                                data-message-error="Something went wrong :( Please contact me directly at &lt;a href=&quot;hello@omahluxurycatering.com&quot;&gt;hello@omahluxurycatering.com&lt;/a&gt;)">
                                                <!-- header -->
                                                <div class="row form__row">
                                                    <div class="col form__col">
                                                        <h3 class="h3 mt-0 mb-0">Enquiries:</h3>
                                                        <p style="font-size: 12px;">For event bookings, private
                                                            tastings, or collaboration requests, fill out our contact
                                                            form or reach out via phone or email. We typically respond
                                                            within 24–48 hours.</p>
                                                    </div>
                                                </div>
                                                <!-- - header -->
                                                <!-- input #1 -->
                                                <div class="row form__row">
                                                    <div class="col form__col">
                                                        <label class="input-float js-input-float">
                                                            <input class="input-float__input" type="text" name="name"
                                                                required data-msg="Please enter your name" />
                                                            <span class="input-float__label">Your Name</span>
                                                            <span class="form__error"></span>
                                                        </label>
                                                    </div>
                                                </div>

                                                <!-- - input #1 -->
                                                <!-- input #2 -->
                                                <div class="row form__row">
                                                    <div class="col form__col">
                                                        <label class="input-float js-input-float">
                                                            <input class="input-float__input" type="email" name="email"
                                                                required="required"
                                                                data-msg="Please enter a correct e-mail" /><span
                                                                class="input-float__label">Your E-mail</span><span
                                                                class="form__error"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <!-- - input #2 -->
                                                <!-- input #2 -->
                                            <div class="row form__row">
                                                <div class="col form__col">
                                                    <label class="input-float js-input-float">
                                                        <input
                                                            class="input-float__input"
                                                            type="tel"
                                                            name="phone_no"
                                                            required
                                                            maxlength="15"
                                                            pattern="[0-9]*"
                                                            inputmode="numeric"
                                                            oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                                            data-msg="Please enter a correct phone"
                                                        />
                                                        <span class="input-float__label">Your Phone</span>
                                                        <span class="form__error"></span>
                                                    </label>
                                                </div>
                                            </div>

                                                <!-- - input #2 -->
                                                <!-- input #3 -->
                                                <div class="row form__row">
                                                    <div class="col form__col">
                                                        <label class="input-float js-input-float">
                                                            <textarea
                                                                class="input-float__input input-float__input_textarea"
                                                                name="message"></textarea><span
                                                                class="input-float__label">Your Message</span><span
                                                                class="form__error"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <!-- - input #3 -->
                                                <!-- submit -->
                                                <div class="row form__row">
                                                    <div class="col form__col form__col_submit">
                                                        <button
                                                            class="button button_solid button_black button_fullwidth"
                                                            data-hover="Send Message"><span
                                                                class="button__label-hover">Send Message</span></button>
                                                    </div>
                                                </div>
                                                <!-- - submit -->

                                                <div class="col form__col">
                                                    <input type="hidden" name="enquiry_status" value="Pending" />
                                                </div>

                                            </form>
                                        </section>
                                        <!-- - section FORM -->
                                    </div>
                                </div>
                            </div>


                            <!-- section CONTACTS -->
                            <div class=" container_px-xs-0"
                                style="background-image: url('https://res.cloudinary.com/djcc1bova/image/upload/v1751628137/1_tkvye0.png'); ">
                                <section class="section section-contacts section-properties section-content"
                                    data-arts-os-animation="data-arts-os-animation">
                                    <div class="container-fluid no-gutters">
                                        <div class="row no-gutters">
                                            <!-- Left: Address Info -->
                                            <div class="col-lg-auto col-12">
                                                <div class="bg-white container-fluid py-md-3 py-1">
                                                    <% addressList.forEach(address=> { %>
                                                        <div class="section-properties__item my-2">
                                                            <div class="figure-info split-text js-split-text">
                                                                <div class="figure-info__option small-caps">
                                                                    <%= address.name %>
                                                                </div>
                                                                <div class="figure-info__value paragraph">
                                                                    <a href="mailto:<%= address.email %>">
                                                                        <%= address.email %>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="section-properties__item my-2">
                                                            <div class="figure-info split-text js-split-text">
                                                                <div class="figure-info__option small-caps">Phone</div>
                                                                <div class="figure-info__value paragraph">+91 <%=
                                                                        address.phone_no %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="section-properties__item my-2">
                                                            <div class="figure-info split-text js-split-text">
                                                                <div class="figure-info__option small-caps">Location
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-12 col-md-8">
                                                                        <div class="figure-info__value paragraph"
                                                                            style="white-space: normal; word-break: break-word;">
                                                                            <%= address.address %>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </div>

                                            <!-- Right: Google Map -->
                                            <div class="col-lg col-12">
                                                <div id="map" style="height: 444px; width: 100%;"></div>

                                                <!-- Hidden markers -->
                                                <div class="gmap__marker d-none" data-marker-lat="18.5213738"
                                                    data-marker-lon="73.8545071" data-marker-content="OMAH">
                                                </div>
                                                <div class="gmap__marker d-none" data-marker-lat="18.5046"
                                                    data-marker-lon="73.8278" data-marker-content="OMAH 2">
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </section>
                            </div>
                            <!-- - section CONTACTS -->

                </main>

                </main>
                <!-- PAGE FOOTER -->
                <%- include('include/footer') %>
                    <!-- - PAGE FOOTER -->
            </div>
            <!-- - PAGE MAIN -->
    </div>
    <canvas id="js-webgl"></canvas>
    <!-- PhotoSwipe -->

    <!-- - PhotoSwipe -->


