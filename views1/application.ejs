<style>
  h2 {
    text-align: center;
    margin-bottom: 20px;
  }

  .table-container {
    width: 100%;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    /* Forces columns to auto-shrink */
    word-wrap: break-word;
  }

  thead {
    background-color: #2a4d8f;
    color: #fff;
  }

  th,
  td {
    padding: 12px 15px;
    text-align: left;
    border: 1px solid #ddd;
    vertical-align: top;
  }

  tr:nth-child(even) {
    background-color: #f2f6ff;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {

    th,
    td {
      padding: 6px 8px;
      /* reduce padding */
      font-size: 12px;
      /* smaller text */
    }

    h2 {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {

    th,
    td {
      padding: 4px 6px;
      font-size: 11px;
    }

    h2 {
      font-size: 14px;
    }
  }
</style>
