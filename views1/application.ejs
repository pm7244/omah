  .slider {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 300px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 10px;
  }

  .slides {
    position: relative;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    object-fit: cover;
    transition: opacity 0.5s ease-in-out;
  }

  .slide.active {
    display: block;
  }

  .slider button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
