<style>
  @media (min-width: 992px) {
    .blog-desktop-padding {
      padding-top: 35px;
      /* Adjust as needed */
    }
  }


  .rs-services-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 16px;
    text-align: start;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .rs-services-thumb img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .rs-services-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .rs-services-title {
    font-size: 18px;
    margin: 12px 0 8px;
  }

  .rs-services-content p.descrip {
    flex-grow: 1;
    font-size: 14px;
    color: #555;
    line-height: 1.5;
  }

  .rs-services-btn-wrapper {
    margin-top: 12px;
  }

  .rs-text-btn,
  .rs-square-btn {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .rs-text-btn {
    color: #0077cc;
  }

  .rs-text-btn:hover {
    text-decoration: underline;
  }

  .rs-square-btn {
    background: #f1f1f1;
    margin-left: 8px;
  }

  .rs-square-btn:hover {
    background: #0077cc;
    color: #fff;
  }


  .swiper-wrapper {
    display: flex;
  }

  /* .swiper-slide {
      display: flex;
      height: auto;
    } */
  .rs-services-item {
    height: 100%;
  }




  .verticals-grid {
    display: stretch;
    /* grid-template-columns: 2fr 8fr 2fr; */
    padding: 10px 20px;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .left-verticals,
  .right-verticals {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .vertical-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
    font-size: 14px;
  }

  .vertical-item img {
    width: 100px;
  }

  .vertical-label {
    font-weight: bold;
    text-transform: uppercase;
  }

  .brand-left .vertical-label {
    order: 2;
    margin-left: 10px;
  }

  .brand-left img {
    order: 1;
  }

  .brand-right img {
    order: 1;
  }

  .brand-right .vertical-label {
    order: 2;
    margin-left: 10px;
  }

  .center-placeholder {
    height: -webkit-fill-available;
    font-size: 20px;
    font-weight: bold;
    color: black;
    background-size: cover;




  }

  .slider {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 300px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 10px;
  }

  .slides {
    position: relative;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    object-fit: cover;
    transition: opacity 0.5s ease-in-out;
  }

  .slide.active {
    display: block;
  }

  .slider button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.4);
    color: white;
    border: none;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 18px;
    border-radius: 4px;
    z-index: 2;
  }

  .slider .prev {
    left: 10px;
  }

  .slider .next {
    right: 10px;
  }

  .verticals-grid {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    /* 3-6-3 layout */

    align-items: center;

  }

  .left-verticals,
  .right-verticals {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .vertical-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px;

  }

  .vertical-label {
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .vertical-item img {
    /* margin-top: 7px; */
    width: 80px;
    height: auto;
  }

  /* Slider Styles */
  .hero-swiper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-swiper .swiper-slide {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 100%;
    min-height: 500px;
  }

  .rs-banner-bg-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    z-index: 1;
  }

  .rs-banner-item-wrapper {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    z-index: 2;
  }

  .rs-banner-content {
    position: relative;
    z-index: 3;
  }

  .center-placeholder {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.1);
    height: 500px;
    position: relative;
    overflow: hidden;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: white !important;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
    width: 44px !important;
    height: 44px !important;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 18px !important;
    font-weight: bold;
  }

  .swiper-pagination-bullet {
    background: white !important;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1 !important;
  }

  .slider .prev {
    left: 10px;
  }

  .slider .next {
    right: 10px;
  }

  .search-container {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
  }

  .search-box {
    padding: 6px 10px;
    width: 600px !important;
  }

  .search-btn {
    padding: 6px 10px;
    background-color: #007bff;
    border: none;
    color: white;
    cursor: pointer;
  }
</style>



<style>
  .whygrate {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px 20px;
  }

  .whygrate-image {
    flex: 1;
  }

  .whygrate-image img {
    max-width: 100%;
    border-radius: 10px;
  }

  .whygrate-content {
    flex: 1;
  }

  .rs-services-details-title {
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 20px;
    color: #333;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    font-size: 18px;
    color: #555;
  }

  .feature-list svg {
    width: 24px;
    height: 24px;
    color: #0056b3;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .whygrate {
      flex-direction: column;
      text-align: center;
    }

    .feature-list li {
      justify-content: center;
    }
  }


  .main-grid {
    display: grid;
    /* grid-template-columns: 2fr 10fr; */
    align-items: center;
    background: white;
    border-color: black;

  }

  .rs-work-step-five {
    padding: 20px 0 30px;
    counter-reset: count;
    /* reset numbering */
  }

  .steps-container {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .step-box {
    flex: 1 1 45%;
    /* 2 per row on desktop */
    min-width: 280px;
    position: relative;
    padding-left: 70px;
    margin-bottom: 20px;
  }

  .offer-num::before {
    counter-increment: count;
    content: counter(count, decimal-leading-zero);
    /* 01, 02, 03 */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    background: #0056b3;
    color: #fff;
    font-size: 18px;
    font-weight: bold;
    border-radius: 50%;
    position: absolute;
    left: 0;
    top: 0;
  }

  .step-box h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .step-box p {
    font-size: 16px;
    color: #555;
    line-height: 1.6;
  }

  /* ✅ Responsive */
  @media (max-width: 768px) {
    .steps-container {
      flex-direction: column;
      /* stack vertically */
    }

    .step-box {
      flex: 1 1 100%;
      padding-left: 70px;
      /* keep number aligned */
    }
  }


  /* Left column (logo) */
  .left-logo {
    text-align: center;
  }

  .left-logo img {
    max-width: 100px;
    height: auto;
  }

  /* Right content */
  .right-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-color: black;
  }

  /* Top bar */
  .top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: black;
    color: white;
    padding: 10px;
    font-size: 14px;
  }

  .top-header .flag {
    font-weight: bold;
  }

  .top-header .catalogue button {
    background-color: #0ea5e9;
    border: none;
    padding: 6px 12px;
    color: white;
    border-radius: 4px;
  }

  /* Middle: Search + contact */
  .middle-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }

  .search-container {
    display: flex;
  }

  .search-container input {
    padding: 5px;
    border: 1px solid #ccc;
  }

  .search-container button {
    padding: 5px 10px;
    background-color: #0ea5e9;
    color: white;
    border: none;
  }

  .contact-info {
    text-align: right;
    font-size: 13px;
    padding: 0 20px;
  }

  /* Bottom nav */
  .bottom-header nav {
    background: black;
    /* padding: 8px; */
    display: flex;
    gap: 15px;
    font-size: 14px;
  }

  .bottom-header nav a {
    color: white;
    text-decoration: none;
  }

  .rs-services-details-btn {
    margin-top: 30px;
    display: flex;
    justify-content: center;
  }
</style>

<style>
  /* body {
      font-family: Arial, sans-serif;
      margin: 20px;
      background: #f9f9f9;
    } */

  .table-container {
    width: 100%;
    overflow-x: auto;
    background: white;
    border: 1px solid #ccc;
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 900px;
    /* Ensures proper layout */
  }

  th,
  td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: left;
    font-size: 14px;
  }

  th {
    background-color: #222;
    color: #fff;
    font-weight: bold;
    text-align: center;
  }

  tr:nth-child(even) {
    background-color: #f2f2f2;
  }

  tr:hover {
    background-color: #e9f4ff;
  }

  td {
    vertical-align: top;
  }

  @media (max-width: 768px) {

    th,
    td {
      padding: 8px;
      font-size: 13px;
    }
  }

  @media (max-width: 480px) {
    table {
      font-size: 12px;
    }
  }
</style>
