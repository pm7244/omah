// ROOM CATEGORY BHK

 const FetchCategory5 = async () => {
    fetch(`${import.meta.env.VITE_CMS_URL}api/getallsub_category`)
      .then((res) => res.json())
      .then((data) => {
        const formattedOptions = data.data.map((item) => ({
          value: item.sub_cat_id,
          label: item.title,
        }));
        setOptions5(formattedOptions);
      });
  };


