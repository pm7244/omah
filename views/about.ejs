                                                        <%= about.hero_title %>
                                                    </h2>
                                                </div>

                                                <div class="w-100"></div>
                                            <div class="section__headline mb-1 mb-md-2"></div>
                                            <div class="w-100"></div>

                                            <div class="w-100"></div>

