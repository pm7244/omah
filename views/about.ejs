            <div class="section-image__wrapper" data-arts-parallax="data-arts-parallax" data-arts-parallax-factor="0.15">
              <div>
                <div class="lazy-bg" data-src="img/assets/project7/img-7-1.jpg"></div>
              </div>
            </div>
          </section> -->
                    <!-- - section IMAGE #1 -->

                    <!-- - sections CONTENT & IMAGE #1 -->
                    <!-- sections CONTENT & IMAGE #1 -->
              <% content.forEach((item) => { %>

  <% if (item.layout === 'default') { %>
    <!-- HERO SECTION -->
    <section class="hero-section" style="background-image:url('/<%= item.image %>')">
      <div class="content">
        <h2 class="" style="color: #ccb561;">
          <%= item.title %>
        </h2>
        <div>
          <p style="color: #ffffff;">
            <%= item.des %>
          </p>
        </div>
      </div>
    </section>

  <% } else if (item.layout === 'text-right') { %>
    <!-- Image Left / Text Right (NO STYLE CHANGE) -->
    <div class="container-fluid no-gutters bg-light-1">
      <div class="row no-gutters align-items-center"
        style="background-image: url('https://res.cloudinary.com/djcc1bova/image/upload/v1751628137/1_tkvye0.png'); background-size: cover;">
        
        <div class="col-lg-6">
          <section class="section section-image section_h-800">
            <div class="section-image__wrapper" data-arts-parallax data-arts-parallax-factor="0.15">
              <div>
                <div class="lazy-bg" style="background-size: cover;" data-src="/<%= item.image %>"></div>
              </div>
            </div>
          </section>
        </div>

        <div class="col-lg-6">
          <section class="section section-content clearfix pt-medium pb-medium container-fluid container-fluid_paddings"
            data-arts-os-animation>
            <div class="section-content__inner">
              <div class="section-content__heading split-text js-split-text mb-1">
                <h2 style="color: #ccb561;"><%= item.title %></h2>
              </div>
              <div class="section-content__text split-text js-split-text">
                <p style="color: #ffffff;"><%= item.des %></p>
              </div>
            </div>
          </section>
        </div>

      </div>
    </div>

  <% } else if (item.layout === 'text-left') { %>
    <!-- Text Left / Image Right (NO STYLE CHANGE) -->
    <div class="container-fluid no-gutters bg-light-1">
      <div class="row no-gutters align-items-center"
        style="background-image: url('https://res.cloudinary.com/djcc1bova/image/upload/v1751628137/1_tkvye0.png'); background-size: cover;">
        
        <div class="col-lg-6">
          <section class="section section-content clearfix pt-medium pb-medium container-fluid container-fluid_paddings"
            data-arts-os-animation>
            <div class="section-content__inner">
              <div class="section-content__heading split-text js-split-text mb-1">
                <h2 style="color: #ccb561;"><%= item.title %></h2>
              </div>
              <div class="section-content__text split-text js-split-text">
                <p style="color: #ffffff;"><%= item.des %></p>
              </div>
            </div>
          </section>
        </div>

        <div class="col-lg-6">
          <section class="section section-image section_h-800">
            <div class="section-image__wrapper" data-arts-parallax data-arts-parallax-factor="0.15">
              <div>
                <div class="lazy-bg" data-src="/<%= item.image %>"></div>
              </div>
            </div>
          </section>
        </div>

      </div>
    </div>

  <% } %>

<% }) %>







                </main>
                <!-- PAGE FOOTER -->
                <%- include('include/footer') %>
                    <!-- - PAGE FOOTER -->
            </div>
            <!-- - PAGE MAIN -->
