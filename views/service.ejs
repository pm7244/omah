        .sort((a, b) => a.sort_order - b.sort_order);

      let parentImage = parent.image.length > 0 ? parent.image[0] : '';
%>

<!-- ========== PARENT SECTION ========== -->
<section class="section section-masthead section-fullheight text-left bg-dark-1"
