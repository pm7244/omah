<style>
  @media (min-width: 992px) {
    .blog-desktop-padding {
      padding-top: 35px;
      /* Adjust as needed */
    }
  }

  .descrip {
    /* word-break: break-all; */
  }

  .verticals-grid {
    display: stretch;
    /* grid-template-columns: 2fr 8fr 2fr; */
    padding: 10px 20px;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .left-verticals,
  .right-verticals {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .vertical-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
    font-size: 14px;
  }

  .vertical-item img {
    width: 100px;
  }

  .vertical-label {
    font-weight: bold;
    text-transform: uppercase;
  }

  .brand-left .vertical-label {
    order: 2;
    margin-left: 10px;
  }

  .brand-left img {
    order: 1;
  }

  .brand-right img {
    order: 1;
  }

  .brand-right .vertical-label {
    order: 2;
    margin-left: 10px;
  }

  .center-placeholder {
    height: -webkit-fill-available;
    font-size: 20px;
    font-weight: bold;
    color: black;
    background-size: cover;




  }

  .slider {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: 300px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 10px;
  }

  .slides {
    position: relative;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    object-fit: cover;
    transition: opacity 0.5s ease-in-out;
  }

  .slide.active {
    display: block;
  }

  .slider button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.4);
    color: white;
    border: none;
    padding: 6px 10px;
    cursor: pointer;
    font-size: 18px;
    border-radius: 4px;
    z-index: 2;
  }

  .slider .prev {
    left: 10px;
  }

  .slider .next {
    right: 10px;
  }

  .verticals-grid {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    /* 3-6-3 layout */

    align-items: center;

  }

  .left-verticals,
  .right-verticals {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .vertical-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 20px;

  }

  .vertical-label {
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .vertical-item img {
    /* margin-top: 7px; */
    width: 80px;
    height: auto;
  }

  /* Slider Styles */
  .hero-swiper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-swiper .swiper-slide {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: 100%;
    min-height: 500px;
  }

  .rs-banner-bg-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    z-index: 1;
  }

  .rs-banner-item-wrapper {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    z-index: 2;
  }

  .rs-banner-content {
    position: relative;
    z-index: 3;
  }

  .center-placeholder {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.1);
    height: 500px;
    position: relative;
    overflow: hidden;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: white !important;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
    width: 44px !important;
    height: 44px !important;
  }

  .swiper-button-next:after,
  .swiper-button-prev:after {
    font-size: 18px !important;
    font-weight: bold;
  }

  .swiper-pagination-bullet {
    background: white !important;
    opacity: 0.5;
  }

  .swiper-pagination-bullet-active {
    opacity: 1 !important;
  }

  .slider .prev {
    left: 10px;
  }

  .slider .next {
    right: 10px;
  }

  .search-container {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
  }

  .search-box {
    padding: 6px 10px;
    width: 600px !important;
  }

  .team-icon i {
    font-size: 225px;
    color: #2d2d2d;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .search-btn {
    padding: 6px 10px;
    background-color: #007bff;
    border: none;
    color: white;
    cursor: pointer;
  }
</style>

<style>
  .main-grid {
    display: grid;
    /* grid-template-columns: 2fr 10fr; */
    align-items: center;
    background: white;
    border-color: black;

  }

  /* Left column (logo) */
  .left-logo {
    text-align: center;
  }

  .left-logo img {
    max-width: 100px;
    height: auto;
  }

  /* Right content */
  .right-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-color: black;
  }

  /* Top bar */
  .top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: black;
    color: white;
    padding: 10px;
    font-size: 14px;
  }

  .top-header .flag {
    font-weight: bold;
  }

  .top-header .catalogue button {
    background-color: #0ea5e9;
    border: none;
    padding: 6px 12px;
    color: white;
    border-radius: 4px;
  }

  /* Middle: Search + contact */
  .middle-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
  }

  .search-container {
    display: flex;
  }

  .search-container input {
    padding: 5px;
    border: 1px solid #ccc;
  }

  .search-container button {
    padding: 5px 10px;
    background-color: #0ea5e9;
    color: white;
    border: none;
  }



  /* Bottom nav */
  .bottom-header nav {
    background: black;
    /* padding: 8px; */
    display: flex;
    gap: 15px;
    font-size: 14px;
  }

  .bottom-header nav a {
    color: white;
    text-decoration: none;
  }
</style>
</head>

