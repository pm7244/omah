<footer class="footer">
    <% if (footer) { %>
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-description">
                    <p style="color: #fff;">
                        <%= footer.footer_description %>
                    </p>
                    <div class="contact-item">
                        <span style="font-family:Jomolhari; font-size: 22px; padding-top: 2%;">Social & Info</span>
                    </div>
                    <section class="widget widget_rhye_social">
                        <!-- content -->
                        <ul class="social">
                            <li class="social__item"><a class="fa fa-instagram" href="#" style="font-size: 23px;"></a>
                            </li>
                            <li class="social__item"><a class="fa fa-facebook-f" href="#" style="font-size: 23px;"></a>
                            </li>
                            <li class="social__item"><a class="fa fa-youtube" href="#" style="font-size: 23px;"></a>
                            </li>

                            <li class="social__item"><a class="fa fa-envelope" href="mailto:"
                                    style="font-size: 23px;"></a></li>


                        </ul>
                        <!-- - content -->
                    </section>
                </div>


                <div class="footer-nav">
                    <div class="contact-item">
                        <span style="font-family:Jomolhari; font-size: 22px;">Links</span>
                    </div>
                    <a href="/privacy-policy">Privacy Policy</a>
                    <a href="/">Our People </a>
                    <a href="/">Gallery</a>


                </div>

           <div class="footer-nav">
  <div class="contact-item" >
    <span style="font-family:Jomolhari; font-size: 22px;" >Services</span>
  </div>

<div class="footer-nav">
  <div class="contact-item">
    <!-- <span>Services</span> -->
  </div>

  <% if (serviceContentMap && serviceContentMap.length > 0) { %>
    <% serviceContentMap.forEach(service => { %>
      <a href="/service_details/<%= service.slug %>"><%- service.title %></a>
    <% }) %>
  <% } %>
</div>


</div>


                

                <!-- Contact Form Section -->
                <div class="footer-contact-form">
                    <div class="contact-item">
                        <span>Get In Touch</span>
                    </div>


                    <form class="footer-form" id="footerContactForm" action="/api/createenquiries" method="POST">
                        <div class="footer-form-group">
                            <input type="text" name="name" placeholder="Your Name" required>
                        </div>
                        <div class="footer-form-group">
                            <input type="email" name="email" placeholder="Your Email" required>
                        </div>
                        <div class="footer-form-group">
                            <input type="tel" name="phone_no" placeholder="Your Phone" maxlength="15" pattern="[0-9]*"
                                inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required>
                        </div>
                        <div class="footer-form-group">
                            <textarea name="message" placeholder="Your Message" rows="4"></textarea>
                        </div>
                        <input type="hidden" name="enquiry_status" value="Pending">
                        <button type="submit" class="footer-form-submit">
                            <span>Send Message</span>
                        </button>
                    </form>

                    <div class="footer-form-success" id="footerFormSuccess" style="display: none;">
                        <p>Thank you! Your message has been sent successfully.</p>
                    </div>

                    <div class="footer-form-error" id="footerFormError" style="display: none;">
                        <p>Sorry, there was an error sending your message. Please try again.</p>
                    </div>
                </div>

            </div>
            <% if (footer.footer_logo && footer.footer_logo.length> 0) { %>
                <div class="footer-main">
                    <!-- <div class="footer-logo">OMAH</div> -->
                    <img class="logo__img-secondary" src="/<%= footer.footer_logo[0] %>" alt="Omah" height="20" />
                </div>
                <% } %>
                    <!-- widgets bottom area -->
                    <div class="footer_area footer_area-border-top pt-sm-3 pb-sm-1 pt-2 pb-0">
                        <div class="row align-items-center">
                            <!-- widget LOGO -->
                            <div class="col-lg-3 footer__column text-center text-lg-left order-lg-1">
                                <% if (footer.footer_logo && footer.footer_logo.length> 0) { %>
                                    <section class="widget widget_rhye_logo">
                                        <!-- content --><a class="logo" href="/">
                                            <div class="logo__wrapper-img">
                                                <!-- primary logo version (for light backgrounds)--><img
                                                    class="logo__img-primary" src="/<%= footer.footer_logo[0] %>"
                                                    alt="Omah" width="120" />
                                                <!-- secondary logo version (for dark backgrounds)--><img
                                                    class="logo__img-secondary" src="/<%= footer.footer_logo[0] %>"
                                                    alt="Omah" width="120" />
                                            </div>
                                        </a>
                                        <!-- - content -->
                                    </section>
                                    <% } %>
                            </div>
                            <!-- - widget LOGO -->
                            <!-- widget SOCIAL -->
                            <div class="col-lg-3 footer__column text-center text-lg-right order-lg-3">
                                <div class="textwidget">
                                    <p style="color: #ffffff;"><small>© 2025 OMAH. Crafted by <a href="/"
                                                target="_blank">Claf</a></small></p>
                                </div>

                            </div>
                            <!-- - widget SOCIAL -->
                            <!-- widget TEXT -->
                            <div class="col-lg-6 footer__column text-center text-lg-center order-lg-2">
                                <section class="widget widget_text">
                                    <!-- content -->
                                    <div class="textwidget">
                                        <!-- <p style="color: #ffffff;"><small>© 2025 OMAH. Crafted by <a href="/" target="_blank">Claf</a></small></p> -->
                                    </div>
                                    <!-- - content -->
                                </section>
                            </div>
                            <!-- - widget TEXT -->
                        </div>
                    </div>
                    <!-- - widgetst bottom area -->
        </div>
        <% } %>
</footer>

<!-- Footer Contact Form Styles -->
<style>
    /* Footer Contact Form Styles */
    .footer-contact-form {
        max-width: 400px;
    }

    .footer-contact-form .contact-item {
        margin-bottom: 1rem;
    }

    .footer-contact-form .contact-item span {
        font-size: 1.1rem;
        font-weight: 600;
        color: #ffffff;
    }

    .footer-form-description {
        color: #cccccc;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        line-height: 1.4;
    }

    .footer-form {
        width: 100%;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
    }

    .footer-form-group {
        margin-bottom: 1rem;
    }

    .footer-form-group input,
    .footer-form-group textarea {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: #ffffff;
        font-size: 14px;
   
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .footer-form-group input:focus,
    .footer-form-group textarea:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.5);
        background: rgba(255, 255, 255, 0.15);
    }

    .footer-form-group input::placeholder,
    .footer-form-group textarea::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .footer-form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .footer-form-submit {
        background: white;
        color: #08372D;
        border: none;
        padding: 12px 24px;
        border-radius: 25px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 0.5rem;
    }

    .footer-form-submit:hover {
        background: #08372D;
        color: white;

    }

    .footer-form-success {
        background: rgba(34, 197, 94, 0.2);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1rem;
    }

    .footer-form-success p {
        color: #22c55e;
        margin: 0;
        font-size: 0.9rem;
    }

    .footer-form-error {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1rem;
    }

    .footer-form-error p {
        color: #ef4444;
        margin: 0;
        font-size: 0.9rem;
    }

    /* Update footer-top grid to accommodate the form */
    .footer-top {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.5fr;
        gap: 2rem;
        margin-bottom: 4rem;
    }

    /* Responsive Design for Footer Form */
    @media (max-width: 1024px) {
        .footer-top {
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 2rem;
        }

        .footer-contact-form {
            grid-column: 1 / -1;
            max-width: 100%;
            margin-top: 2rem;
        }
    }

    @media (max-width: 768px) {
        .footer-top {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .footer-contact-form {
            margin-top: 1.5rem;
        }

        .footer-form-group input,
        .footer-form-group textarea {
            padding: 10px 14px;
            font-size: 14px;
        }

        .footer-form-submit {
            padding: 12px 20px;
            font-size: 14px;
        }
    }

    @media (max-width: 480px) {
        .footer-form-description {
            font-size: 0.85rem;
            margin-bottom: 1rem;
        }

        .footer-form-group {
            margin-bottom: 0.8rem;
        }

        .footer-form-group input,
        .footer-form-group textarea {
            padding: 10px 12px;
            font-size: 13px;
        }

        .footer-form-submit {
            padding: 10px 18px;
            font-size: 13px;
        }
    }
</style>

<!-- Footer Contact Form JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const footerForm = document.getElementById('footerContactForm');
        const successMessage = document.getElementById('footerFormSuccess');
        const errorMessage = document.getElementById('footerFormError');

        if (footerForm) {
            footerForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                successMessage.style.display = 'none';
                errorMessage.style.display = 'none';

                const formData = new FormData(this);
                const jsonData = {};
                formData.forEach((val, key) => jsonData[key] = val);

                const submitBtn = this.querySelector('.footer-form-submit');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span>Sending...</span>';
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/api/createenquiries', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(jsonData),
                    });

                    const result = await response.json();

                    if (result.status) {
                        successMessage.style.display = 'block';
                        footerForm.reset();

                        // Scroll to message
                        successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });

                        // Hide success message after 5s
                        setTimeout(() => {
                            successMessage.style.display = 'none';
                        }, 5000);
                    } else {
                        throw new Error(result.message || 'Something went wrong');
                    }
                } catch (err) {
                    console.error('Error:', err);
                    errorMessage.style.display = 'block';
                    errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => {
                        errorMessage.style.display = 'none';
                    }, 5000);
                } finally {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            });
        }
    });

    
</script>

