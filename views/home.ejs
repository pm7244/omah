                              </div>
                            </section>
                          </div>

                          <div class="image-carousel-track" style="background-color: aqua;">
                            <% if (missionSlider && missionSlider.length) { %>
                              <% missionSlider.forEach(img=> { %>
                                <div class="image-con col-12 col-sm-6 col-lg-4">
                                  <img src="/<%= img %>" alt="Mission Image">
                                </div>
                                <% }) %>
                                  <% } %>
                          </div>

                        </div>
                      </section>





                      <style>
                        .image-carousel-wrapper::after {
                          content: "";
                          position: absolute;
                          inset: 0;
                          background: rgba(59, 59, 59, 0.6);
                          /* BLACK opacity */
                          background: linear-gradient(to right, black, rgba(0, 0, 0, 0.445), rgba(0, 0, 0, 0), rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.0), rgba(0, 0, 0, 0.0));
                          z-index: 9;
                        }










                        .image-carousel-wrapper {
                          width: 100%;
                          height: 100vh;
                          position: relative;
                        }

                        .image-carousel-track {
                          width: 100%;
                          height: 100%;
                          display: flex;
                          z-index: 1;
                        }

                        .image-con {
                          width: calc(100/3);
                          height: 100%;
                          padding: 0;
                          z-index: 1;
                        }

                        .image-con img {
                          width: 100%;
                          height: 100%;
                          object-fit: cover;
                          z-index: 1;
                        }

                        .image-carousel-content {
                          position: absolute;
                          left: 13.5px;
                          bottom: 20%;
                          z-index: 9999;
                        }

                        .image-carousel-content h2,
                        p {
                          color: #ffffff;
                        }
                      </style>

















        </main>
