    <canvas id="js-webgl"></canvas>
    <!-- PhotoSwipe -->

<script>
 function initCarousel() {
              const existingTrack = document.querySelector('.carousel-track');
              if (existingTrack && existingTrack.carouselCleanup) {
                existingTrack.carouselCleanup();
              }

              const track = document.querySelector('.carousel-track');
              const cards = document.querySelectorAll('.card');
              
              if (!track || cards.length === 0) return;

              const clonedCards = track.querySelectorAll('.card[data-cloned="true"]');
              clonedCards.forEach(clone => clone.remove());

              track.style.transform = 'translateX(0)';

              const cardCount = cards.length;
              let currentIndex = 0;
              let intervalId = null;
              let isAutoScrollPaused = false;

              const cardsArray = Array.from(cards);
              cardsArray.forEach(card => {
                const clone = card.cloneNode(true);
                clone.setAttribute('data-cloned', 'true');
                track.appendChild(clone);
              });

              function getScrollDistance() {
                const wrapperWidth = track.parentElement.offsetWidth;
                const trackStyle = window.getComputedStyle(track);
                const cardStyle = window.getComputedStyle(cards[0]);
                const cardPercent = parseFloat(cardStyle.width);
                const gapPercent = wrapperWidth * parseFloat(trackStyle.gap) / 100;
                
                return cardPercent + gapPercent;
              }

              function moveToIndex(index, animate = true) {
                const scrollDistance = getScrollDistance();
                if (scrollDistance === 0) return;
                
                currentIndex = index;
                const translateX = currentIndex * scrollDistance;
                
                if (!animate) {
                  track.style.transition = 'none';
                }
                
                track.style.transform = `translateX(-${translateX}px)`;
                
                if (!animate) {
                  setTimeout(() => {
                    track.style.transition = 'transform 0.8s ease-in-out';
                  }, 50);
                }

                if (currentIndex >= cardCount) {
                  setTimeout(() => {
                    track.style.transition = 'none';
                    currentIndex = 0;
                    track.style.transform = translateX(0);
                    setTimeout(() => {
                      track.style.transition = 'transform 0.8s ease-in-out';
                    }, 50);
                  }, 800);
                }
              }

              function moveCarousel() {
                moveToIndex(currentIndex + 1);
              }

              function movePrevious() {
                if (currentIndex > 0) {
                  moveToIndex(currentIndex - 1);
                } else {
                  currentIndex = cardCount;
                  moveToIndex(cardCount, false);
                  setTimeout(() => {
                    moveToIndex(cardCount - 1);
                  }, 50);
                }
              }

              function startCarousel() {
                if (intervalId) clearInterval(intervalId);
                if (!isAutoScrollPaused) {
                  intervalId = setInterval(moveCarousel, 3000);
                }
              }

              function stopCarousel() {
                if (intervalId) {
                  clearInterval(intervalId);
                  intervalId = null;
                }
              }

              startCarousel();

              let touchStartX = 0;
              let touchEndX = 0;
              let touchStartY = 0;
              let touchEndY = 0;
              let isDragging = false;
              let hasMoved = false;

              function handleTouchStart(e) {
                touchStartX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                touchStartY = e.type.includes('mouse') ? e.clientY : e.touches[0].clientY;
                isDragging = true;
                hasMoved = false;
                stopCarousel();
              }

              function handleTouchMove(e) {
                if (!isDragging) return;
                
                touchEndX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                touchEndY = e.type.includes('mouse') ? e.clientY : e.touches[0].clientY;
                
                const diffX = touchStartX - touchEndX;
                const diffY = touchStartY - touchEndY;
                const minSwipeDistance = 50;

                if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > minSwipeDistance && !hasMoved) {
                  hasMoved = true;
                  
                  if (diffX > 0) {
                    moveCarousel();
                  } else {
                    movePrevious();
                  }

                  isAutoScrollPaused = true;
                  setTimeout(() => {
                    isAutoScrollPaused = false;
                    startCarousel();
                  }, 3000);
                }
              }

              function handleTouchEnd(e) {
                if (!isDragging) return;
                isDragging = false;

                if (!hasMoved) {
                  startCarousel();
                }

                touchStartX = 0;
                touchEndX = 0;
                touchStartY = 0;
                touchEndY = 0;
                hasMoved = false;
              }

              track.addEventListener('touchstart', handleTouchStart, { passive: true });
              track.addEventListener('touchmove', handleTouchMove, { passive: true });
              track.addEventListener('touchend', handleTouchEnd, { passive: true });

              track.addEventListener('mousedown', handleTouchStart);
              track.addEventListener('mousemove', handleTouchMove);
              track.addEventListener('mouseup', handleTouchEnd);
              track.addEventListener('mouseleave', (e) => {
                if (isDragging) {
                  handleTouchEnd(e);
                }
              });

              let resizeTimeout;
              const handleResize = () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(() => {
                  const scrollDistance = getScrollDistance();
                  if (scrollDistance === 0) return;
                  track.style.transition = 'none';
                  const translateX = currentIndex * scrollDistance;
                  track.style.transform = `translateX(-${translateX}px)`;
                  setTimeout(() => {
                    track.style.transition = 'transform 0.8s ease-in-out';
                  }, 50);
                }, 250);
              };
              
              window.addEventListener('resize', handleResize);

              const cleanup = () => {
                stopCarousel();
                track.removeEventListener('mouseenter', stopCarousel);
                track.removeEventListener('mouseleave', startCarousel);
                track.removeEventListener('touchstart', handleTouchStart);
                track.removeEventListener('touchmove', handleTouchMove);
                track.removeEventListener('touchend', handleTouchEnd);
                track.removeEventListener('mousedown', handleTouchStart);
                track.removeEventListener('mousemove', handleTouchMove);
                track.removeEventListener('mouseup', handleTouchEnd);
                window.removeEventListener('resize', handleResize);
              };

              track.carouselCleanup = cleanup;

              return cleanup;
            }

            function setupCarousel() {
              setTimeout(() => {
                console.log('Initializing carousel...');
                initCarousel();
              }, 300);
            }

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', setupCarousel);
            } else {
              setupCarousel();
            }

            window.addEventListener('pageshow', function(event) {
              console.log('pageshow event');
              if (event.persisted) {
                setupCarousel();
              }
            });

            if (typeof barba !== 'undefined') {
              console.log('Barba.js detected, setting up hooks');
              
              barba.hooks.beforeLeave(() => {
                console.log('Barba beforeLeave');
                const track = document.querySelector('.carousel-track');
                if (track && track.carouselCleanup) {
                  track.carouselCleanup();
                }
              });

              barba.hooks.afterEnter(() => {
                console.log('Barba afterEnter');
                setupCarousel();
              });

              barba.hooks.after(() => {
                console.log('Barba after');
                setupCarousel();
              });
            }

            let menuObserverTimeout;
            const menuButton = document.getElementById('js-burger');
            if (menuButton) {
              menuButton.addEventListener('click', function() {
                console.log('Menu button clicked');
                clearTimeout(menuObserverTimeout);
                menuObserverTimeout = setTimeout(() => {
                  const carousel = document.querySelector('.carousel-track');
                  if (carousel) {
                    console.log('Re-initializing carousel after menu navigation');
                    setupCarousel();
                  }
                }, 1000);
              });
            }

            document.addEventListener('click', function(e) {
              const isMenuLink = e.target.closest('.menu-overlay a');
              if (isMenuLink) {
                console.log('Menu link clicked:', isMenuLink.href);
                setTimeout(() => {
                  const carousel = document.querySelector('.carousel-track');
                  if (carousel) {
                    console.log('Re-initializing carousel after menu link click');
                    setupCarousel();
                  }
                }, 800);
              }
            }, true);

            let observerTimeout;
            const observer = new MutationObserver((mutations) => {
              clearTimeout(observerTimeout);
              observerTimeout = setTimeout(() => {
                const carousel = document.querySelector('.carousel-track');
                const hasCards = document.querySelectorAll('.card').length > 0;
                
                if (carousel && hasCards) {
                  if (!carousel.carouselCleanup) {
                    console.log('Carousel detected by observer, initializing...');
                    setupCarousel();
                  }
                }
              }, 200);
            });

            observer.observe(document.body, {
              childList: true,
              subtree: true
            });

            window.addEventListener('popstate', function() {
              console.log('popstate event');
              setTimeout(setupCarousel, 500);
            });

            window.addEventListener('refreshCarousel', function() {
              console.log('Manual carousel refresh triggered');
              setupCarousel();
            });

            let checkCount = 0;
            const forceCheckInterval = setInterval(() => {
              checkCount++;
              const carousel = document.querySelector('.carousel-track');
              const hasCards = document.querySelectorAll('.card').length > 0;
              
              if (carousel && hasCards && !carousel.carouselCleanup) {
                console.log('Force check: initializing carousel');
                setupCarousel();
              }
              
              if (checkCount >= 5) {
                clearInterval(forceCheckInterval);
              }
            }, 2000);




















// Force reload every time user visits THIS service details page
(function() {
  // Set a unique key for this specific page
  const pageKey = 'servicePageReload';
  
  // Check if we're coming from a navigation within the site
  const navigationType = performance.getEntriesByType('navigation')[0];
  
  if (navigationType) {
    // Check if this is a reload or a navigation
    if (navigationType.type === 'reload') {
      // Page was manually reloaded, don't force another reload
      sessionStorage.removeItem(pageKey);
      return;
    }
  }
  
  // Check if we should reload for this specific page
  const shouldReload = sessionStorage.getItem(pageKey);
  
  if (shouldReload === 'visited') {
    // User has visited this page before in current session, force reload
    sessionStorage.removeItem(pageKey);
    
    // Use a small timeout to ensure page loads before reloading
    setTimeout(() => {
      window.location.reload(true); // true forces reload from server
    }, 100);
  } else {
    // First visit to this page in current session
    sessionStorage.setItem(pageKey, 'visited');
  }
  
  // Also handle browser back/forward buttons
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      // Page was loaded from cache (like when using back button)
      sessionStorage.removeItem(pageKey);
      window.location.reload(true);
    }
  });
  
  // Handle SPA navigation if you have client-side routing
  window.addEventListener('popstate', function() {
    sessionStorage.removeItem(pageKey);
    window.location.reload(true);
  });
})();
