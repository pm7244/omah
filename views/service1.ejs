    content="https://res.cloudinary.com/djcc1bova/image/upload/v1751632401/omah-logo-dark-potrait_u285gy.png" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/x-icon" href="/" />
  <style>
    .main-content {
      flex: 1;
      padding: 2rem;
      text-align: center;
    }

    .footer {
      background-color: #1a1a1a;
      color: #ffffff;
      padding: 3rem 2rem 2rem;
      position: relative;
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 4rem;
    }

    .footer-description {
      font-size: 1rem;
      line-height: 1.6;
      color: #cccccc;
      max-width: 400px;
    }

    .footer-nav {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-nav h3 {
      font-size: 1.1rem;
      font-weight: normal;
      margin-bottom: 0.5rem;
    }

    .footer-nav a {
      color: #cccccc;
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.3s ease;
    }

    .footer-nav a:hover {
      color: #ffffff;
    }

    .footer-contact {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-contact .contact-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .footer-contact .contact-item::before {
      content: '+';
      font-size: 1.2rem;
      color: #ffffff;
    }

    .footer-contact a {
      color: #cccccc;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-contact a:hover {
      color: #ffffff;
    }

    .footer-main {

      margin-bottom: 3rem;
    }

    .footer-logo {
      font-size: 4rem;
      font-weight: bold;
      letter-spacing: 0.05em;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    .footer-bottom {


      padding-top: 2rem;
      border-top: 1px solid #333333;
      font-size: 0.9rem;
      color: #999999;
    }

    .footer-bottom a {
      color: #999999;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-bottom a:hover {
      color: #cccccc;
    }

    .footer-left {
      display: flex;
      gap: 2rem;
    }

    .footer-right {
      display: flex;
      gap: 2rem;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .footer {
        padding: 2rem 1rem 1.5rem;
      }

      .footer-top {
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
      }

      .footer-description {
        max-width: 100%;
      }

      .footer-nav {
        gap: 0.8rem;
      }

      .footer-logo {
        font-size: 2.5rem;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
      }

      .footer-left,
      .footer-right {
        flex-direction: column;
        gap: 1rem;
      }
    }

    @media (max-width: 480px) {
      .footer {
        padding: 1.5rem 1rem 1rem;
      }

      .footer-top {
        gap: 1.5rem;
      }

      .footer-logo {
        font-size: 2rem;
      }

      .footer-description {
        font-size: 0.9rem;
      }

      .footer-nav h3 {
        font-size: 1rem;
      }

      .footer-nav a {
        font-size: 0.9rem;
      }

      .footer-contact {
        gap: 0.8rem;
      }
    }

    /* Tablet specific adjustments */
    @media (min-width: 769px) and (max-width: 1024px) {
      .footer-top {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }

      .footer-description {
        grid-column: 1 / -1;
        max-width: 100%;
        margin-bottom: 1rem;
      }
    }
  </style>
</head>

