<!DOCTYPE html>
<html lang="en">

<head>

  <%- include('include/head') %>


    <style>
      .overlay-center-section .overlay-text-top {
        position: absolute;
        top: 20px;
        /* adjust as needed */
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        text-align: center;
        width: 100%;
      }

      .overlay-center-section .overlay-text-top h2 {
        margin: 25px;
        /* font-size: 2rem; */
      }

      .slider2-banner {
        position: relative;
        height: 35vh;
        overflow: hidden;
      }

      .slider2-title {
        position: absolute;
        top: 65px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        text-align: center;
      }


      .slider2-wrapper {
        position: relative;
        width: 100%;
        height: 95vh;
        overflow: hidden;
      }

      .slider2-content {
        position: absolute;
        top: 40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        text-align: center;
      }

      .slider2-section {
        padding: 0 !important;
        margin: 0 !important;
      }

      .slider2-track {
        display: flex;
        position: relative;
        z-index: 1;
        height: 100%;
      }


      .slider2-item {
        width: calc(100% / 2);
        height: 100%;
        flex-shrink: 0;
      }

      .slider2-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }



      .overlay-center-section {
        position: relative;
        min-height: 1000px;
      }


      .mySlides2-slide {
        display: flex;
        justify-content: center;
      }

      .mySlides2-slide img {
        width: 48%;
        height: 729px;
        object-fit: cover;
      }

      .slideshow-container {
        position: relative;
        max-width: 100%;
        max-height: 93vh;
        margin: auto;
        overflow: hidden;
      }

      .mySlides {
        display: none;
      }

      .slide-image {
        width: 100%;
        object-fit: cover;
      }

      .slider-center-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #3D5E00;
        font-size: 2rem;
        font-weight: bold;
      }

      .overlay-image-center {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        transform: translateY(-50%);
        z-index: 2;
      }

      .overlay-image-center img {
        margin-top: 27px;
        width: 100%;
        height: 729px;
        object-fit: cover;
        display: block;
      }

      .overlay-image-middle {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 2;
      }

      .overlay-image-middle img {
        width: 100%;
        height: 729px;
        object-fit: cover;
        display: block;
      }

      .slider2-section .section-image__wrapper {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .main-content {
        flex: 1;
        padding: 2rem;
        text-align: center;
      }

      .team-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 45%;
        width: 80%;
        margin: 50px auto 0;
        text-align: start;
        margin-top: 550px;
      }

      .team-member h2 {
        color: #CCB561;
        font-size: 1.8rem;
        margin-bottom: 5px;
      }

      .team-member p {
        color: #ffffff;
        font-size: 1rem;
      }

      .footer {
        background-color: #1a1a1a;
        color: #ffffff;
        padding: 3rem 2rem 2rem;
        position: relative;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 3rem;
        margin-bottom: 4rem;
      }

      .footer-description {
        font-size: 1rem;
        line-height: 1.6;
        color: #cccccc;
        max-width: 400px;
      }

      .footer-nav {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .footer-nav h3 {
        font-size: 1.1rem;
        font-weight: normal;
        margin-bottom: 0.5rem;
      }

      .footer-nav a {
        color: #cccccc;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.3s ease;
      }

      .footer-nav a:hover {
        color: #ffffff;
      }

      .footer-contact {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .footer-contact .contact-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .footer-contact .contact-item::before {
        content: '+';
        font-size: 1.2rem;
        color: #ffffff;
      }

      .footer-contact a {
        color: #cccccc;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .footer-contact a:hover {
        color: #ffffff;
      }

      .footer-main {
        margin-bottom: 3rem;
      }

      .footer-logo {
        font-size: 4rem;
        font-weight: bold;
        letter-spacing: 0.05em;
        color: #ffffff;
        margin-bottom: 1rem;
      }

      .footer-bottom {
        padding-top: 2rem;
        border-top: 1px solid #333333;
        font-size: 0.9rem;
        color: #999999;
      }

      .footer-bottom a {
        color: #999999;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .footer-bottom a:hover {
        color: #cccccc;
      }

      .footer-left {
        display: flex;
        gap: 2rem;
      }

      .footer-right {
        display: flex;
        gap: 2rem;
      }

      .hero-section {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 0 5%;
        overflow: hidden;
      }

      .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;

        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }

      .content {
        max-width: 600px;
        z-index: 2;
      }

      .main-heading {
        font-size: 30px;
        color: white;
        margin-bottom: 2rem;
        letter-spacing: 2px;
        font-weight: 300;
        line-height: 1.2;
        position: relative;
      }

      .main-heading::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 100px;
        height: 3px;
        border-radius: 2px;
      }

      .description {
        color: white;
        font-size: 1.1rem;
        line-height: 1.8;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
        margin-bottom: 1.5rem;
      }

      .highlight-text {
        color: #FFD700;
        font-weight: 400;
      }

      .floating-elements {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        z-index: 1;
      }

      .floating-crystal {
        position: absolute;
        width: 4px;
        height: 4px;
        background: #FFD700;
        border-radius: 50%;
        box-shadow: 0 0 10px #FFD700;
        animation: float 8s ease-in-out infinite;
      }

      .luxury-border {
        position: absolute;
        top: 20px;
        left: 20px;
        right: 20px;
        bottom: 20px;
        border: 2px solid rgba(255, 215, 0, 0.3);
        border-radius: 10px;
        pointer-events: none;
        z-index: 1;
      }

      .hero-section:hover .crystal-overlay {
        animation-duration: 3s;
      }

      .content:hover .main-heading {
        text-shadow: 3px 3px 10px rgba(255, 215, 0, 0.5);
        transition: text-shadow 0.3s ease;
      }

      @media (prefers-reduced-motion: reduce) {

        .crystal-overlay,
        .floating-crystal,
        .content {
          animation: none;
        }
      }

        .teamtext {
         padding-top: 70px ;
        padding-bottom: 28px;
}


