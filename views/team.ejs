<body>
  <div data-barba="wrapper">
    <!-- start header -->
    <%- include('include/header') %>
      <!-- end header -->
      <!-- PAGE MAIN -->
      <div class="js-smooth-scroll bg-white" id="page-wrapper" data-barba="container">
        <main class="page-wrapper__content">
          <!-- section MASTHEAD FULLSCREEN -->
          <section class="section section-masthead section-fullheight text-left bg-dark-1"
            data-arts-os-animation="data-arts-os-animation" data-arts-theme-text="light"
            data-background-color="var(--color-dark-1)">
            <div class="section-masthead__inner section-fullheight__inner container-fluid"
              style="min-height: auto !important;">
              <header class="row section-masthead__header justify-content-left">
                <div class="col-lg-12">

                  <section
                    class="section section-content clearfix pt-medium pb-medium container-fluid container-fluid_paddings"
                    data-arts-os-animation="data-arts-os-animation">
                    <div class="section-content__inner">
                      <div class="w-100"></div>
                      <!-- <div class="section__headline mb-1 mb-md-2"></div> -->
                      <div class="w-100"></div>

                      <div class="w-100"></div>
                      <div class="team-container">
                        <% for (let i=0; i < teams.length; i++) { %>
                          <div class="team-member">
                            <h2>
                              <%= teams[i].name %>
                            </h2>
                            <p>
                              <%= teams[i].designation %>
                            </p>
                          </div>
                          <% } %>
                      </div>

                    </div>
                  </section>


                  <section>
                    <div style="text-align: center;">
                      <h2 style="color:#CCB561;">
                        <%= team.slider1_title %>
                      </h2>
                    </div>
                  </section>
                </div>

                <div class="section-masthead__wrapper-scroll-down section-masthead__wrapper-scroll-down_left">

                </div>
              </header>
            </div>
            <div class="section-image section-masthead__background section-masthead__background_fullscreen">
              <div class="section-image__wrapper js-transition-img" data-arts-parallax="data-arts-parallax"
                data-arts-parallax-factor="0.15">
                <div class="js-transition-img__transformed-el">
                  <div class="lazy-bg" data-src="/<%= team.banner_img %>"
                    style="background-image: url('/<%= team.banner_img %>');">
                  </div>
                </div>
              </div>
              <!-- overlay-->
              <div class="overlay overlay_dark-30 section-masthead__overlay"></div>
            </div>
          </section>
          <!-- - section MASTHEAD FULLSCREEN -->
          <% const sliderItems=team && team.slider1_img ? team.slider1_img : []; %>

            <!-- section IMAGE #1 -->
            <section class="section section-image section_h-800">
              <div class="section-image__wrapper" data-arts-parallax="data-arts-parallax"
                data-arts-parallax-factor="0.15">
                <% sliderItems.forEach((item, index)=> { %>
                  <div class="mySlides fade">
                    <img class="slide-image" src="/<%= item %>" alt="slider1_img <%= index + 1 %>">
                  </div>
                  <% }) %>
              </div>
            </section>
            <!-- - section IMAGE #1 -->
         

            <% const slider2Items=team && team.slider2_img ? team.slider2_img : []; %>

                <section style="background-image: url('/<%= team.banner_img %>'); height: 100% !important;  background-repeat: no-repeat; background-size: cover;" >
                  <div class="teamtext" >
                  <h2 style="color:#CCB561; text-align: center; margin-top: 0% !important; margin-bottom: 0% !important; "   ><%= team.slider2_title %></h2>
                  </div>
                </section>

               
        
              <section class="section slider2-wrapper">
                <div class="slider2-track">
                  <% slider2Items.forEach((item)=> { %>
                    <div class="slider2-item">
                      <img src="/<%= item %>" alt="slider image">
                    </div>
                    <% }) %>
                </div>
              </section>

              <section class="section section-image section_h-800 overlay-center-section">
                <!-- Background Banner Image -->
                

                       <section class="section section-image section_h-800 overlay-center-section" style="background-image: url('/<%= team.banner_img %>'); background-repeat: no-repeat; background-size: cover;" >
                  <div class="teamtext1" >
                  <h2 style="color:#CCB561; text-align: center;"><%= team.img_title %></h2>
                  </div>
                </section>
                <section>

                <div class="overlay-image-center">
                  <img src="/<%= team.image %>" alt="BTS Image" />
                </div>

              </section>

        </main>
        <!-- PAGE FOOTER -->
        <%- include('include/footer') %>
          <!-- - PAGE FOOTER -->
      </div>
      <!-- - PAGE MAIN -->
  </div>
  <canvas id="js-webgl"></canvas>
  <!-- PhotoSwipe -->

  <script>
    const slider2Track = document.querySelector('.slider2-track');
    const slider2Item = slider2Track.querySelector('.slider2-item');

    let slider2Width = slider2Item.getBoundingClientRect().width;
    let slider2Scroll = slider2Width;
    let slider2Animating = false;

    window.addEventListener('resize', () => {
      slider2Width = slider2Item.getBoundingClientRect().width;
      slider2Scroll = slider2Width;
    });

    function moveSlider2Next() {
      if (slider2Animating) return;
      slider2Animating = true;

      slider2Track.style.transition = 'transform 0.8s ease-in-out';
      slider2Track.style.transform = `translateX(-${slider2Scroll}px)`;

      slider2Track.addEventListener('transitionend', function handler() {
        slider2Track.removeEventListener('transitionend', handler);
        slider2Track.style.transition = 'none';
        slider2Track.appendChild(slider2Track.firstElementChild);
        slider2Track.style.transform = 'translateX(0)';
        slider2Track.offsetHeight;
        slider2Track.style.transition = 'transform 0.8s ease-in-out';
        slider2Animating = false;
      });
    }

    setInterval(moveSlider2Next, 3000);
  </script>

  <script>
    let slideIndex = 0;
    let slideTimer;
    const slides = document.getElementsByClassName("mySlides");
    // Show first slide immediately
    function showSlideImmediately() {
      if (slides.length > 0) {
        slides[0].style.display = "block";
      }
    }
    function showSlides() {
      if (slides.length === 0) return;
      for (let i = 0; i < slides.length; i++) {
        slides[i].style.display = "none";
      }
      slides[slideIndex].style.display = "block";
      slideIndex = (slideIndex + 1) % slides.length;
    }
    function startAutoSlide() {
      showSlides(); // Show first slide with JS
      slideTimer = setInterval(showSlides, 3000);
    }
    function pauseSlide() {
      clearInterval(slideTimer);
    }
    // Wait for all images to load before starting slider
    window.addEventListener('load', () => {
      showSlideImmediately();
      startAutoSlide();
    });
  </script>
  <!-- - PhotoSwipe -->


  <!-- - Slider Textures Shaders -->
  <!-- VENDOR SCRIPTS -->
  <script src="/js/vendor.js"></script>
  <!-- - VENDOR SCRIPTS -->
  <!-- COMPONENTS -->
  <script src="/js/components.js"></script>
  <!-- - COMPONENTS -->
  <script
    src="https://maps.googleapis.com/maps/api/js?callback=Function.prototype&amp;key=AIzaSyBwR_TrF6h7-pMxkKv_q2t8BXX3w6QuFOc"
    async></script>
</body>

</html>