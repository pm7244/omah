    <style>
        .main-content {
            flex: 1;
            padding: 2rem;
            text-align: center;
        }

        .footer {
            background-color: #1a1a1a;
            color: #ffffff;
            padding: 3rem 2rem 2rem;
            position: relative;
        }

        .footer-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 4rem;
        }

        .footer-description {
            font-size: 1rem;
            line-height: 1.6;
            color: #cccccc;
            max-width: 400px;
        }

        .footer-nav {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-nav h3 {
            font-size: 1.1rem;
            font-weight: normal;
            margin-bottom: 0.5rem;
        }

        .footer-nav a {
            color: #cccccc;
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

        .footer-nav a:hover {
            color: #ffffff;
        }

        .footer-contact {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .footer-contact .contact-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .footer-contact .contact-item::before {
            content: '+';
            font-size: 1.2rem;
            color: #ffffff;
        }

        .footer-contact a {
            color: #cccccc;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-contact a:hover {
            color: #ffffff;
        }

        .footer-main {

            margin-bottom: 3rem;
        }

        .footer-logo {
            font-size: 4rem;
            font-weight: bold;
            letter-spacing: 0.05em;
            color: #ffffff;
            margin-bottom: 1rem;
        }

        .footer-bottom {


            padding-top: 2rem;
            border-top: 1px solid #333333;
            font-size: 0.9rem;
            color: #999999;
        }

        .footer-bottom a {
            color: #999999;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-bottom a:hover {
            color: #cccccc;
        }

        .footer-left {
            display: flex;
            gap: 2rem;
        }

        .footer-right {
            display: flex;
            gap: 2rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .footer {
                padding: 2rem 1rem 1.5rem;
            }

            .footer-top {
                grid-template-columns: 1fr;
                gap: 2rem;
                margin-bottom: 2rem;
            }

            .footer-description {
                max-width: 100%;
            }

            .footer-nav {
                gap: 0.8rem;
            }

            .footer-logo {
                font-size: 2.5rem;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }

            .footer-left,
            .footer-right {
                flex-direction: column;
                gap: 1rem;
            }
        }

        @media (max-width: 480px) {
            .footer {
                padding: 1.5rem 1rem 1rem;
            }

            .footer-top {
                gap: 1.5rem;
            }

            .footer-logo {
                font-size: 2rem;
            }

            .footer-description {
                font-size: 0.9rem;
            }

            .footer-nav h3 {
                font-size: 1rem;
            }

            .footer-nav a {
                font-size: 0.9rem;
            }

            .footer-contact {
                gap: 0.8rem;
            }
        }

        /* Tablet specific adjustments */
        @media (min-width: 769px) and (max-width: 1024px) {
            .footer-top {
                grid-template-columns: 1fr 1fr;
                gap: 2rem;
            }

            .footer-description {
                grid-column: 1 / -1;
                max-width: 100%;
                margin-bottom: 1rem;
            }
        }
    </style>
    <style>
        .contact-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            max-width: 1000px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 600px;
        }

        .form-section {
            background: linear-gradient(135deg, #8B5CF6 0%, #A855F7 50%, #9333EA 100%);
            padding: 50px 40px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .contact-info {
            background: #F8FAFC;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-title {
            font-size: 28px;
            font-weight: 300;
            margin-bottom: 40px;
            color: white;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
            opacity: 0.9;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 15px 0;
            background: transparent;
            border: none;
            border-bottom: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-bottom-color: rgba(255, 255, 255, 0.8);
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        textarea {
            resize: vertical;
            min-height: 120px;
            font-family: inherit;
        }

        .send-btn {
            background: #EC4899;
            color: white;
            border: none;
            padding: 18px 40px;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 20px;
            align-self: flex-start;
        }

        .send-btn:hover {
            background: #0e572c;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(236, 72, 153, 0.4);
        }

        .contact-info h2 {
            font-size: 28px;
            color: #1F2937;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .contact-info p {
            color: #6B7280;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .contact-item {
            display: flex;
            align-items: center;

        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #8B5CF6, #A855F7);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .contact-icon svg {
            width: 24px;
            height: 24px;
            fill: white;
        }

        .contact-details h4 {
            font-size: 16px;
            font-weight: 600;
            color: #1F2937;
            margin-bottom: 5px;
        }

        .contact-details span {
            color: #6B7280;
            font-size: 14px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .contact-container {
                grid-template-columns: 1fr;
                margin: 10px;
            }

            .form-section,
            .contact-info {
                padding: 30px 25px;
            }

            .form-title,
            .contact-info h2 {
                font-size: 24px;
            }

            .contact-item {
                margin-bottom: 25px;
            }

            .contact-icon {
                width: 45px;
                height: 45px;
                margin-right: 15px;
            }

            .send-btn {
                width: 100%;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 10px;
            }

            .form-section,
            .contact-info {
                padding: 25px 20px;
            }

            .form-title,
            .contact-info h2 {
                font-size: 22px;
            }

            .contact-icon {
                width: 40px;
                height: 40px;
            }

            .contact-icon svg {
                width: 20px;
                height: 20px;
            }
        }

        /* Success message styling */
        .success-message {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: rgba(255, 255, 255, 0.9);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
        }
    </style>

</head>

